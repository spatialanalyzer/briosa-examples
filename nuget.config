<?xml version="1.0" encoding="utf-8"?>
<!--
  Candidate phase only. Until Briosa.2026.1.0529.7 0.5.0 is published, it comes from
  the local feed that eng/Build-Candidates.ps1 fills. The separate package folder keeps
  the unpublished 0.5.0 out of the user-wide NuGet cache, where it would later shadow
  the published package. Delete this file when the tutorial pins the published release.
-->
<configuration>
  <config>
    <add key="globalPackagesFolder" value="artifacts/candidates/nuget-packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="briosa-candidates" value="artifacts/candidates/nuget" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="briosa-candidates">
      <package pattern="Briosa.2026.1.0529.7" />
    </packageSource>
  </packageSourceMapping>
</configuration>
